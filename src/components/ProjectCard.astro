---
interface Props {
  title: string;
  description: string;
  githubUrl?: string;
  liveUrl?: string;
}

const { title, description, githubUrl, liveUrl } = Astro.props;
---

<article class="card">
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="links">
    <div class="links">
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer">
          GitHub{' '}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      )}
      {liveUrl && (
        <a href={liveUrl} target="_blank" rel="noopener noreferrer">
          Ver ao vivo{' '}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      )}
    </div>
  </div>
</article>
<style>
  .card {
    background-color: var(--bg-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);

    padding: 1.5rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.75rem;
  }
  .card h3 {
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--text-main);
  }

  .card p {
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .links {
    margin-block-start: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .links a {
    font-weight: 500;
    font-size: var(--font-size-sm);
    color: var(--text-muted);
  }

  .links a:hover {
    color: var(--text-main);
  }
</style>
